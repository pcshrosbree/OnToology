<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.microsoft.com/telemeta.owl"
         xmlns="http://www.microsoft.com/telemeta.owl#">

<owl:Ontology rdf:about="http://www.microsoft.com/telemeta.owl"/>

<owl:ObjectProperty rdf:about="#hasOperation">
  <rdfs:domain rdf:resource="#Service"/>
  <rdfs:range rdf:resource="#Operation"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasName">
  <rdfs:domain rdf:resource="#Operation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Service">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Operation">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Read">
  <rdfs:subClassOf rdf:resource="#Operation"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Operation"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasName"/>
          <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">read</owl:hasValue>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <owl:equivalentClass rdf:resource="#ReadA"/>
</owl:Class>

<owl:Class rdf:about="#Write">
  <rdfs:subClassOf rdf:resource="#Operation"/>
</owl:Class>

<owl:Class rdf:about="#ReadA">
  <rdfs:subClassOf rdf:resource="#Operation"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Operation"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasName"/>
          <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">read</owl:hasValue>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <owl:equivalentClass rdf:resource="#Read"/>
</owl:Class>


</rdf:RDF>
